# Obtain these from https://my.telegram.org -> API development tools.
TELEGRAM_API_ID=123456
TELEGRAM_API_HASH=replace_me

# Persistent Local Bot API storage.
BOT_API_DATA_DIR=/srv/telegram-bot-api/data

# The UID/GID that should own the shared data directory.
# Use the same UID/GID for the bot process when the bot reads local files.
BOT_API_UID=1000
BOT_API_GID=1000

# Keep this as master initially; pin to a tested commit for reproducible builds.
TELEGRAM_BOT_API_REF=master

TZ=Asia/Bangkok
