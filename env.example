# Bika Adding-only

BOT_TOKEN=
MONGO_URI=
DB_NAME=bika_adding_lookup
OWNER_IDS=
ADDING_CHAT_ID=

LOG_LEVEL=INFO
DEFAULT_COMMAND=/hallow
DEFAULT_SOURCE_KEY=items_characters_hallow
OWNER_USERNAME=@Official_Bika
ADDED_LOG_CHANNEL=

RUN_MODE=auto
PUBLIC_URL=
WEBHOOK_PATH=/webhook
WEBHOOK_SECRET=
PORT=8080

# Forwarded-source allow-list. Comma-separated usernames, titles, or chat IDs.
SOURCE_CHANNELS=

# Optional source -> output command overrides. Format: source:command,source2:command
FORWARD_SOURCE_COMMANDS=

# AddHelper userbot
ADD_HELPER_ENABLED=true
API_ID=
API_HASH=
SESSION_STRING=
DEFAULT_SEND_DELAY=5
MAX_SEND_DELAY=30
MAX_RETRIES=5
RETRY_BASE_DELAY=3
CONTROL_POLL_INTERVAL=2
CONTROL_HISTORY_LIMIT=25
STATE_FILE=seeder_state.json
CLEAR_STATE_ON_FINISH=true
SESSIONS_DIR=sessions
ADD_HELPER_STARTUP_MESSAGE=true

# Optional source bot overrides used by HelperManager
CATCHER_INLINE_BOT=@Character_Catcher_Bot
SEIZER_INLINE_BOT=@Character_Seizer_Bot
CAPTURE_INLINE_BOT=@CaptureCharacterBot
TAKERS_INLINE_BOT=@Takers_character_bot
GRAB_INLINE_BOT=@Grab_Your_Waifu_Bot
