# Unified Adding + Lookup Bot
BOT_TOKEN=
MONGO_URI=
DB_NAME=bika_adding_lookup
OWNER_IDS=123456789

# Exactly one group performs Adding/ingest. All other chats perform lookup.
ADDING_CHAT_ID=-1001234567890

AUTO_LOOKUP_ENABLED=true
LOOKUP_IN_PRIVATE=true
LOOKUP_IN_GROUPS=true
LOOKUP_REPLY_NOT_FOUND=true

# Deployment mode:
# VPS  -> polling
# Render -> webhook
# auto -> webhook when PUBLIC_URL exists, otherwise polling
RUN_MODE=polling

# Render webhook settings
PUBLIC_URL=https://your-service.onrender.com
WEBHOOK_PATH=/webhook
WEBHOOK_SECRET=change-me
PORT=10000
HOST=0.0.0.0

# Helper userbot for Adding workers
API_ID=
API_HASH=
SESSION_STRING=
HELPER_TARGET_CHAT=-1001234567890

# Optional helper source bots
CATCH_BOT=@CharacterCatcherBot
GRAB_BOT=@GrabGardenBot
SENPAI_BOT=@SenpaiCatcher
HALLOW_BOT=@CharacterHallowBot
TAKERS_BOT=@TakersBot

# Lookup tuning
PHOTO_PHASH_THRESHOLD=8
PHOTO_DHASH_THRESHOLD=12
VIDEO_FRAME_THRESHOLD=10
VIDEO_AVG_THRESHOLD=12
MAX_PHOTO_CANDIDATES=1200
MAX_VIDEO_CANDIDATES=1500
LOG_LEVEL=INFO
