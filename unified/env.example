# Unified Adding + Lookup
BOT_TOKEN=
MONGO_URI=
DB_NAME=bika_adding_lookup
OWNER_IDS=123456789

# ONLY this chat can create Adding records.
# Forward character posts from source channels into this group.
ADDING_CHAT_ID=-1001234567890

AUTO_LOOKUP_ENABLED=true
LOOKUP_IN_PRIVATE=true
LOOKUP_IN_GROUPS=true
LOOKUP_REPLY_NOT_FOUND=true

# VPS: polling
# Render: webhook
RUN_MODE=polling
PUBLIC_URL=
WEBHOOK_PATH=/webhook
WEBHOOK_SECRET=
PORT=10000
HOST=0.0.0.0

# Lookup tuning
PHOTO_PHASH_THRESHOLD=8
PHOTO_DHASH_THRESHOLD=12
VIDEO_FRAME_THRESHOLD=10
VIDEO_AVG_THRESHOLD=12
MAX_PHOTO_CANDIDATES=1200
MAX_VIDEO_CANDIDATES=1500
LOG_LEVEL=INFO

# Helper Userbot uses a Telegram user session for source-channel forwarding.
# Source-bot DM/crawler/automatic command sending is disabled.

# Helper Userbot (source-channel forwarding only)
API_ID=
API_HASH=
SESSION_STRING=
SOURCE_CHANNELS=@source_channel_1,@source_channel_2
# Optional destination for /helperinline output. Inline results do NOT create Adding DB records.
INLINE_OUTPUT_CHAT_ID=
HELPER_FORWARD_DELAY=1
HELPER_MAX_HISTORY=500
HELPER_INLINE_TIMEOUT=20
